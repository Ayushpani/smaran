{
  "name": "smaran",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "turbo run dev:app",
    "format-lint": "bunx biome check --write",
    "check-types": "turbo run check-types",
    "try": "STORE=memory EMBEDDER=hash SANDBOX_API_KEY=sk_local_dev bun run apps/api/src/index.ts",
    "test": "turbo run test --filter=@repo/core --filter=@repo/language --filter=@repo/voice --filter=@repo/api --filter=smaran-mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@hono/zod-validator": "^0.7.1",
    "drizzle-orm": "^0.44.3",
    "postgres": "^3.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.4",
    "turbo": "^2.5.4",
    "typescript": "5.8.3",
    "wrangler": "^4.42.2"
  }
}

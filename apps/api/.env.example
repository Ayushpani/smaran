# ─── Storage ──────────────────────────────────────────────────────────
# "memory"   — in-process store, no DB, data lost on restart. Great for
#              a first tour and for tests.
# "supabase" — Postgres+pgvector via Supabase. DATABASE_URL required.
STORE=memory

# Supabase pooled connection string (only used when STORE=supabase).
# Dashboard → Settings → Database → Connection string → Transaction pooler.
DATABASE_URL=

PORT=8787
CORS_ORIGIN=*

# ─── Embedder ─────────────────────────────────────────────────────────
# "local"  — free multilingual model running in-process (default). No key,
#            no per-call cost. First start downloads ~120 MB to MODEL_CACHE_DIR.
# "openai" — any /v1/embeddings host (OpenAI, Together, Ollama, …).
# "hash"   — deterministic stub for tests only; recall quality is random.
# Don't switch embedders on a database that already has memories: vectors
# from different models aren't comparable.
EMBEDDER=local
LOCAL_EMBED_MODEL=Xenova/multilingual-e5-small
MODEL_CACHE_DIR=.smaran/models
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBED_MODEL=text-embedding-3-small

# ─── Reranker ─────────────────────────────────────────────────────────
# "local" — free cross-encoder re-orders the top RERANK_POOL candidates for
#           English queries (+13 pts hit@1 on LoCoMo, ~50–80 ms). "none" — off.
RERANKER=local
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_POOL=40

# ─── Multiple instances ──────────────────────────────────────────────
# With STORE=supabase, rate limits, voice turn buffers and live events are
# shared through Postgres (SHARED_STATE=auto). LISTEN/NOTIFY needs a direct
# connection, not a transaction pooler:
# EVENTS_DATABASE_URL=postgresql://…:5432/…

# ─── Sandbox auth ─────────────────────────────────────────────────────
# Only used when STORE=memory. Persistent mode uses api_keys table.
SANDBOX_API_KEY=sk_local_dev
